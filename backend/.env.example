# ── App ────────────────────────────────────────────────────────────────────────
DEBUG=false
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-strong-random-secret-key-here
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Comma-separated allowed CORS origins (add your frontend URL in production)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Google sign-in (Client ID only - no secret, we verify the ID token directly) ─
# Create one at https://console.cloud.google.com/apis/credentials
# ("Create credentials" -> "OAuth client ID" -> "Web application")
GOOGLE_CLIENT_ID=

# ── OpenAI ─────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-proj-...
OPENAI_MODEL_LIGHT=gpt-4o-mini
OPENAI_MODEL_QUALITY=gpt-4o-mini

# ── Gemini (Cortex enrichment only - free tier, falls back to OpenAI if unset/failing) ──
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# ── Job search providers ────────────────────────────────────────────────────────
JSEARCH_API_KEY=your-jsearch-rapidapi-key
ADZUNA_APP_ID=your-adzuna-app-id
ADZUNA_APP_KEY=your-adzuna-app-key
ADZUNA_COUNTRY=fr

# ── Database (PostgreSQL + asyncpg, transaction-mode pooler, port 6543 - not 5432) ──
DATABASE_URL=postgresql+asyncpg://user:password@host:6543/postgres
CORTEX_DATABASE_URL=postgresql+asyncpg://user:password@host:6543/postgres

# ── Redis (for Celery) ─────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Flower dashboard auth (user:password) ───────────────────────────────────────
FLOWER_BASIC_AUTH=admin:change-m

# ── AWS S3 (optional — leave empty to use local disk storage) ──────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
S3_BUCKET=