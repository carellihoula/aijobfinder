# ── App ────────────────────────────────────────────────────────────────────────
DEBUG=false
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-strong-random-secret-key-here
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Comma-separated allowed CORS origins (add your frontend URL in production)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Comma-separated admin emails allowed to trigger Cortex ingestion (leave empty = all users)
ADMIN_EMAILS=admin@example.com

# ── OpenAI ─────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-proj-...
OPENAI_MODEL=gpt-4o-mini

# ── Job search providers ────────────────────────────────────────────────────────
JSEARCH_API_KEY=your-jsearch-rapidapi-key
ADZUNA_APP_ID=your-adzuna-app-id
ADZUNA_APP_KEY=your-adzuna-app-key
ADZUNA_COUNTRY=fr

# ── Database (PostgreSQL + asyncpg, port 5432 — not 6543) ──────────────────────
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/postgres
CORTEX_DATABASE_URL=postgresql+asyncpg://user:password@host:5432/postgres

# ── Redis (for Celery) ─────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── AWS S3 (optional — leave empty to use local disk storage) ──────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
S3_BUCKET=

# ── Cover letter PDF backend ───────────────────────────────────────────────────
# "reportlab" (no system deps) or "weasyprint" (needs libpango)
COVER_LETTER_BACKEND=reportlab